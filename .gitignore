__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/
dist/
build/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/reports/ui_*.png
data/reports/real_e2e_*/transition_preview.*
*.npy
*.npz
.DS_Store

# --- large data & derived artifacts (regenerable via scripts, iCloud-backed) ---
# (pattern is data/reports/* rather than data/reports/ so the exception below
#  can work at all — git never descends into an excluded directory)
data/reports/*
# ...except the measured corpus priors, which the decision layer reads at
# runtime. The blanket rule swept them up, so a clean clone silently fell back
# to defaults and ranked transitions differently from a developer machine —
# the engine's own measured result was missing from the shipped product.
# 1.5 kB of aggregates only: relation percentages, medians, quintiles. No track
# ids, no paths, nothing identifying a recording, so it carries the same weight
# as the figures already published in docs/EVALUATION.md.
!data/reports/corpus_priors/
!data/reports/corpus_priors/priors_v1.json
data/processed/
data/cache/
data/exports/
data/examples/*.wav
data/examples/*.mp3
outputs/
tmp/
.venv_uv_blocked/

# --- design binaries live outside git (Figma/exports too big for repo) ---
*.fig
*.zip
*.key

# --- audio never enters this repository, on any path ---
# Policy: docs/CORPUS_ETHICS.md — features are kept, source audio is deleted and
# never redistributed. The rules above were path-scoped, which let two Demucs
# vocal stems (~29 MB) and fifteen symlinks named after licensed tracks reach a
# public repo. These are format-scoped so no future path can repeat it.
*.mp3
*.wav
*.aiff
*.aif
*.flac
*.m4a
*.ogg
*.opus

# --- private experiment data: own recordings, licensed audio, stem caches ---
# Everything here is either Janek's own material or derived from it. The README
# is tracked so the convention survives; nothing else ever leaves this machine.
# Katalog eksperymentów: WYNIKI I DANE zostają na dysku (są ogromne),
# ale PRZEPISY — skrypty i opisy — jadą z repozytorium.
# Decyzja Janka 17.08. Powód: dwa razy przejechaliśmy się na tym, że
# policzona praca istniała tylko na jednej maszynie — priors_v1.json
# pod zbiorczą regułą i profil_in_between.py, o którym audyt napisał,
# że nie istnieje, bo nie było go w gicie.
experiments_priv/**
!experiments_priv/**/
!experiments_priv/**/*.py
!experiments_priv/**/*.md

# katalog roboczy asystenta: ustawienia lokalne + kopie robocze drzewa
.claude/
