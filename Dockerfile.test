# Headless test image for the Qt host/widget net.
#
# WHY THIS EXISTS: on macOS (Darwin 25) the PySide6 `offscreen` platform plugin
# loads only in a short window after each `pip install`, then macOS provenance /
# Gatekeeper blocks the unsigned pip dylibs and every Qt test skips or aborts
# (see docs / memory: dancelab-qt-headless-fragile). Linux has no such gate, so
# `offscreen` Qt just works and the 33 host/widget tests actually EXECUTE here.
#
# Build:  docker build -f Dockerfile.test -t dancelab-qt-tests .
# Run:    docker run --rm dancelab-qt-tests
# (see scripts/run_qt_tests_docker.sh for the one-command wrapper)

FROM python:3.12-slim

WORKDIR /app

# System libraries PySide6 6.7 needs even for the `offscreen` platform:
#   - GL/EGL + xkbcommon + dbus + glib + fontconfig/freetype  → QtGui/QtWidgets
#   - x11/xext/xrender                                          → linked by Qt libs
#   - gstreamer base + good/libav                              → QtMultimedia (pair_review)
#   - libsndfile1 + ffmpeg                                     → audio decode (engine)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libegl1 libxkbcommon0 libdbus-1-3 libglib2.0-0 \
    libfontconfig1 libfreetype6 libx11-6 libxext6 libxrender1 \
    libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
    gstreamer1.0-plugins-good gstreamer1.0-libav \
    libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install project + all extras the host tests need:
#   audio (engine analysis), desktop (PySide6), dev (pytest), viz (reports).
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
RUN pip install --no-cache-dir ".[audio,viz,desktop,dev]"

COPY tests ./tests

# Linux offscreen Qt — the whole reason for this image.
ENV QT_QPA_PLATFORM=offscreen

# Default: run the Qt-dependent safety net (the tests that skip/abort on macOS).
# Each file runs in its own pytest process to avoid QApplication-singleton
# cross-module crashes; exit non-zero if any file fails.
CMD ["bash", "-c", "\
  set -e; \
  for f in test_host_simple_mode test_pair_review test_host_qt_app \
           test_host_desktop test_host_project test_host_runtime; do \
    echo \"===== $f =====\"; \
    python -m pytest \"tests/$f.py\" -p no:cacheprovider -q || exit 1; \
  done; \
  echo 'ALL QT NET FILES PASSED'"]
